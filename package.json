{
  "name": "nextjs-postgres-auth-template",
  "version": "1.0.0",
  "description": "A Next.js + PostgreSQL starter template with authentication, sessions, RBAC, and email activation.",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "pretest": "kill-port 3000",
    "test": "npm run services:up && npm run services:wait:database && concurrently -n next,jest --hide next -k -s command-jest \"cross-env NODE_ENV=development next dev\" \"cross-env NODE_ENV=test jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -m infra/migrations create",
    "migrations:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migrations:up:dry": "node-pg-migrate -m infra/migrations --envPath .env.development --dry-run up",
    "migrations:status": "node-pg-migrate -m infra/migrations --envPath .env.development status",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "prepare": "husky",
    "commit": "cz",
    "check-secrets": "secretlint \"**/*\""
  },
  "author": "Danilo Marra",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.2",
    "cookie": "1.0.2",
    "dotenv": "16.4.5",
    "dotenv-expand": "11.0.6",
    "next": "^15",
    "next-connect": "1.0.0",
    "node-pg-migrate": "7.6.1",
    "nodemailer": "8.0.10",
    "pg": "8.12.0",
    "react": "^19",
    "react-dom": "^19",
    "swr": "^2.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.1",
    "@commitlint/config-conventional": "19.4.1",
    "@faker-js/faker": "9.7.0",
    "@secretlint/secretlint-rule-preset-recommend": "8.2.4",
    "chalk": "^5.3.0",
    "commitizen": "4.3.1",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "^15",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "husky": "9.1.5",
    "jest": "29.7.0",
    "kill-port": "^2.0.1",
    "prettier": "3.3.3",
    "secretlint": "8.2.4",
    "set-cookie-parser": "2.7.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
